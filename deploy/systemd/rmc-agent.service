# User unit: ~/.config/systemd/user/rmc-agent.service
# Runs as the user's real account, with that account's ordinary OS authority.
[Unit]
Description=RMC Device Agent
After=network-online.target

[Service]
Type=exec
ExecStart=%h/.local/bin/rmc agent run --config %h/.config/rmc/agent.json
WorkingDirectory=%h
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
