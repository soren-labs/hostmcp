# User unit: ~/.config/systemd/user/roost-agent.service
# Runs as the user's real account, with that account's ordinary OS authority.
[Unit]
Description=Roost Device Agent
After=network-online.target

[Service]
Type=exec
ExecStart=%h/.local/bin/roost agent run --config %h/.config/roost/agent.json
WorkingDirectory=%h
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
