# User unit: ~/.config/systemd/user/rmc-node.service
# Runs as the user's real account, with that account's ordinary OS authority.
[Unit]
Description=RMC node
After=network-online.target

[Service]
Type=exec
ExecStart=%h/.local/bin/rmc node run --config %h/.config/rmc/node.json
WorkingDirectory=%h
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
